# Atoll settings. Copy to .env and fill in what you use; commented lines show the
# default. For containerized evals pass this file with --env-file: it goes to the
# runner (and the grader's judge) only, never to the code-execution sandbox.
# Precedence for run settings: CLI flag > task.toml > this file > default.

# ── Model endpoint ───────────────────────────────────────────────────────────
# An OpenAI-compatible endpoint (e.g. a LiteLLM proxy), with scheme. Leave both
# empty to call providers directly (see Provider keys).
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Default model for atoll-run when --model is not given: an endpoint alias, or a litellm
# provider-prefixed name in direct mode (e.g. gemini/gemini-2.5-pro).
MODEL_ALIAS=

# ── Provider keys ────────────────────────────────────────────────────────────
# Used by direct calls (no endpoint, or a model listed in ATOLL_DIRECT_MODELS), under
# litellm's usual names. Per-model keys, base URLs and headers:
# agents/runner/model_config.example.yaml.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#VOLCENGINE_API_KEY=

# ── Routing ──────────────────────────────────────────────────────────────────
# Model-name prefixes (comma-separated, like NO_PROXY) that go direct even when
# LITELLM_BASE_URL is set; everything else uses the endpoint.
#ATOLL_DIRECT_MODELS=openai/,gemini/

# ── Network (containerized evals) ────────────────────────────────────────────
# The runner's network: off = only the hosts in ATOLL_EGRESS_ALLOW, through the
# eval's egress proxy; on = ordinary outbound access. The sandbox never has one.
#ATOLL_NETWORK=off
# Hosts reachable with the network off (comma-separated host:port). Default: the
# LITELLM_BASE_URL host. List every host you call, e.g. the endpoint plus direct
# providers: your-endpoint-host:443,api.openai.com:443
#ATOLL_EGRESS_ALLOW=

# ── Run limits ───────────────────────────────────────────────────────────────
# Steps and wall-clock seconds per run; the token budget is off unless set.
#MAX_STEPS=250
#TIMEOUT=3600
#TOKEN_BUDGET=128000

# ── Grading ──────────────────────────────────────────────────────────────────
# Judge model for atoll-grade (required there unless --judge-model is given),
# parallel judge calls, and extra completion args as JSON.
#ATOLL_JUDGE_MODEL=
#ATOLL_JUDGE_CONCURRENCY=4
#ATOLL_JUDGE_EXTRA_ARGS={}

# ── Tools and system prompt ──────────────────────────────────────────────────
# Opt-in LibreOffice tools (recalculate_spreadsheet, convert_document_to_pdf);
# off keeps the model-visible tool surface identical to Archipelago's.
#ATOLL_OFFICE_TOOLS=off
# Global system prompt file (a task's own system prompt still wins). Default:
# agents/runner/system_prompts/atoll_agents.md; Mercor's verbatim reference is
# apex_agents.md beside it. In containers use run_eval.sh --system-prompt-file
# instead: host paths are not visible inside the runner.
#ATOLL_SYSTEM_PROMPT_FILE=

# ── Advanced (rarely changed) ────────────────────────────────────────────────
# Code-execution sandbox image (built by scripts/build_sandbox_image.sh with
# Archipelago's code-server package profile). Model code never runs on the host.
#ATOLL_SANDBOX_IMAGE=atoll-sandbox:latest
# LibreOffice binary for recalculation and conversion (default: soffice on PATH).
#ATOLL_SOFFICE=
