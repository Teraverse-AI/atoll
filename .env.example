# Your OpenAI-compatible endpoint (e.g. a LiteLLM proxy)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Direct-to-provider mode (no proxy): leave LITELLM_BASE_URL empty and set the
# provider keys you use, e.g.
#VOLCENGINE_API_KEY=
#GEMINI_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
# Model names are then litellm provider-prefixed (e.g. "gemini/gemini-2.5-pro").

# Default model: a proxy alias (e.g. "gpt-4o-mini") or, in direct mode, a
# litellm provider-prefixed name (e.g. "gemini/gemini-2.5-pro")
MODEL_ALIAS=

# Agent loop stop conditions (optional; task.toml values take precedence)
MAX_STEPS=250
TIMEOUT=3600
# Token budget is OFF by default; set a number to enable it.
#TOKEN_BUDGET=128000

# Code execution REQUIRES Docker Desktop — model code never runs on the host.

# Containerized evals (scripts/run_eval.sh): the runner's network, like MAX_STEPS
# (--network flag > task.toml [atoll] network > this > default off). off = the runner
# reaches only the allow-listed LLM endpoint via the eval's egress proxy.
#ATOLL_NETWORK=off
# Allow-list for network=off (comma-separated host:port). Default: the host of
# LITELLM_BASE_URL. Direct mode must list provider hosts, e.g.:
#ATOLL_EGRESS_ALLOW=api.openai.com:443,generativelanguage.googleapis.com:443

# Sandbox image (default atoll-sandbox:latest, built by scripts/build_sandbox_image.sh
# with the same preinstalled package profile as Archipelago's code server).
#ATOLL_SANDBOX_IMAGE=atoll-sandbox:latest
